local function AdalariOtomatikBul()
    local potansiyelKlasorler = {"Islands", "Island", "Locations", "Map", "Spawns", "SpawnLocations", "Areas"}
    local yeniBulunanSayisi = 0
    for _, klasorAdi in ipairs(potansiyelKlasorler) do
        local klasor = workspace:FindFirstChild(klasorAdi)
        if klasor then
            for _, obje in ipairs(klasor:GetChildren()) do
                if obje:IsA("Model") and obje.PrimaryPart then
                    _G.Adalar["[Auto] " .. obje.Name] = obje.PrimaryPart.Position
                    yeniBulunanSayisi = yeniBulunanSayisi + 1
                elseif obje:IsA("BasePart") then
                    _G.Adalar["[Auto] " .. obje.Name] = obje.Position
                    yeniBulunanSayisi = yeniBulunanSayisi + 1
                end
            end
        end
    end
end
