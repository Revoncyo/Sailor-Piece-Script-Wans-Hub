local canavarSet = {}
local bossSet = {}
local npcSet = {}

local function SaveCache()
    if not writefile then return end
    local data = {
        Canavarlar = _G.Canavarlar,
        Bosslar = _G.Bosslar,
        Npcler = _G.Npcler,
        Koor = {}
    }
    for isim, pos in pairs(_G.Koordinatlar) do
        data.Koor[isim] = {X = pos.X, Y = pos.Y, Z = pos.Z}
    end
    pcall(function() writefile(CacheFileName, HttpService:JSONEncode(data)) end)
end

local function LoadCache()
    if readfile and isfile and isfile(CacheFileName) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(CacheFileName)) end)
        if success and type(result) == "table" then
            _G.Canavarlar = result.Canavarlar or {}
            _G.Bosslar = result.Bosslar or {}
            _G.Npcler = result.Npcler or {}
            for _, v in ipairs(_G.Canavarlar) do canavarSet[v] = true end
            for _, v in ipairs(_G.Bosslar) do bossSet[v] = true end
            for _, v in ipairs(_G.Npcler) do npcSet[v] = true end
            if result.Koor then
                for isim, posTbl in pairs(result.Koor) do
                    _G.Koordinatlar[isim] = Vector3.new(posTbl.X, posTbl.Y, posTbl.Z)
                end
            end
        end
    end
end

