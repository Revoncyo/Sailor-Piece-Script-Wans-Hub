local function OyuncuLeveliniGetir()
    local level = nil
    pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            for _, v in ipairs(ls:GetChildren()) do
                local n = string.lower(v.Name)
                if n == "level" or n == "lvl" or n == "lv" then
                    level = tonumber(v.Value)
                    return
                end
            end
        end
        
        local data = LocalPlayer:FindFirstChild("Data")
        if data then
            for _, v in ipairs(data:GetChildren()) do
                local n = string.lower(v.Name)
                if n == "level" or n == "lvl" or n == "lv" then
                    level = tonumber(v.Value)
                    return
                end
            end
        end

        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, v in ipairs(pg:GetDescendants()) do
                if v:IsA("TextLabel") and v.Visible then
                    local txt = string.lower(string.gsub(v.Text, " ", ""))
                    local l1 = string.match(txt, "^level(%d+)$")
                    local l2 = string.match(txt, "^lv%.?(%d+)$")
                    local l3 = string.match(txt, "^[%[%(]lv%.?(%d+)[%]%)]$")
                    
                    local found = l1 or l2 or l3
                    if found then
                        level = tonumber(found)
                        return
                    end
                end
            end
        end
    end)
    
    return level or 1
end

