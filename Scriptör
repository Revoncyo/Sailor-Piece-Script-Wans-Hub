    AyarlarTab:AddButton("🌍 Auto Discover All Islands (Scan)", function()
        if _G.HaritaTaraniyor then return end
        _G.HaritaTaraniyor = true
        task.spawn(function()
            local siraliAdalar = {}
            for isim, pos in pairs(_G.Adalar) do table.insert(siraliAdalar, {Adi = isim, Koor = pos}) end
            table.sort(siraliAdalar, function(a, b) return a.Adi < b.Adi end)

            for i, ada in ipairs(siraliAdalar) do
                if not _G.HaritaTaraniyor then break end
                
                pcall(function()
                    game.StarterGui:SetCore("SendNotification", {
                        Title = "🌍 Island Scan",
                        Text = "Scanning " .. i .. "/" .. #siraliAdalar .. ":\n" .. ada.Adi,
                        Duration = 4;
                    })
                end)
                
                _G.TeleportingTo = ada.Koor
                
                local char = LocalPlayer.Character
                while _G.HaritaTaraniyor and char and char:FindFirstChild("HumanoidRootPart") do
                    local dist = (char.HumanoidRootPart.Position - ada.Koor).Magnitude
                    if dist < 60 then break end
                    task.wait(0.5)
                end
                
                if _G.HaritaTaraniyor then
                    task.wait(4)
                end
            end

            if _G.HaritaTaraniyor then
                _G.HaritaTaraniyor = false
                _G.TeleportingTo = nil
                pcall(function()
                    game.StarterGui:SetCore("SendNotification", {
                        Title = "✅ Done",
                        Text = "Map scan complete! All available NPCs saved.",
                        Duration = 5;
                    })
                end)
            end
        end)
    end)

