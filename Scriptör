local function GoreviIptalEt()
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, v in ipairs(pg:GetDescendants()) do
                if (v:IsA("TextButton") or v:IsA("ImageButton")) and EkrandaGorunurMu(v) then
                    local parentIsQuest = false
                    local currentParent = v.Parent
                    for i = 1, 5 do 
                        if currentParent and (currentParent:IsA("GuiObject") or currentParent:IsA("ScreenGui")) then
                            local pName = string.lower(currentParent.Name)
                            if string.find(pName, "quest") or string.find(pName, "task") or string.find(pName, "tracker") or string.find(pName, "mission") then
                                parentIsQuest = true
                                break
                            end
                            currentParent = currentParent.Parent
                        else
                            break
                        end
                    end

                    if parentIsQuest then
                        local n = string.lower(v.Name)
                        local t = v:IsA("TextButton") and string.lower(v.Text) or ""
                        if string.find(n, "cancel") or string.find(n, "abandon") or string.find(n, "quit") or string.find(n, "drop") or
                           string.find(t, "cancel") or string.find(t, "abandon") or string.find(t, "quit") or string.find(t, "drop") then
                            
                            if getconnections then
                                for _, conn in pairs(getconnections(v.MouseButton1Click)) do conn:Fire() end
                            end
                            
                            local cx = v.AbsolutePosition.X + (v.AbsoluteSize.X / 2)
                            local cy = v.AbsolutePosition.Y + (v.AbsoluteSize.Y / 2) + 36
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                            task.wait(0.05)
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                        end
                    end
                end
            end
        end
        
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local rName = string.lower(v.Name)
                if string.find(rName, "quest") and (string.find(rName, "cancel") or string.find(rName, "abandon") or string.find(rName, "drop")) then
                    v:FireServer()
                    v:FireServer("Cancel")
                    v:FireServer("Abandon")
                end
            end
        end
    end)
end

