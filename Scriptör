local function ListeleriGuncelle()
    local yeniBulundu = false
    local function TipeGoreEkle(isim, tur, pos)
        local temiz = TemizIsim(isim)
        if temiz == "" or temiz == "Model" or temiz == "Part" or temiz == "Folder" then return end
        if Players:FindFirstChild(temiz) then return end
        if tur == "NPC" then
            if not npcSet[temiz] then npcSet[temiz] = true; table.insert(_G.Npcler, temiz); yeniBulundu = true end
        elseif tur == "Boss" then
            if not bossSet[temiz] then bossSet[temiz] = true; table.insert(_G.Bosslar, temiz); yeniBulundu = true end
        else
            if not canavarSet[temiz] then canavarSet[temiz] = true; table.insert(_G.Canavarlar, temiz); yeniBulundu = true end
        end
        if pos and not _G.Koordinatlar[temiz] then
            _G.Koordinatlar[temiz] = pos
            yeniBulundu = true
        end
    end
    local enemiesFolder = workspace:FindFirstChild("NPCs")
    if enemiesFolder then
        for _, obj in ipairs(enemiesFolder:GetChildren()) do
            if obj:IsA("Model") then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                local pos = hrp and hrp.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                if pos and not Players:GetPlayerFromCharacter(obj) then
                    local isimLower = string.lower(obj.Name)
                    if string.find(isimLower, "boss") then
                        TipeGoreEkle(obj.Name, "Boss", pos)
                    else
                        TipeGoreEkle(obj.Name, "Canavar", pos)
                    end
                end
            end
        end
    end
    local serviceFolder = workspace:FindFirstChild("ServiceNPCs")
    if serviceFolder then
        for _, obj in ipairs(serviceFolder:GetChildren()) do
            if obj:IsA("Model") then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                local pos = hrp and hrp.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                if pos then TipeGoreEkle(obj.Name, "NPC", pos) end
            end
        end
    end
    if yeniBulundu then
        table.sort(_G.Canavarlar)
        table.sort(_G.Bosslar)
        table.sort(_G.Npcler)
        SaveCache()
    end
    return yeniBulundu
end
ListeleriGuncelle()

