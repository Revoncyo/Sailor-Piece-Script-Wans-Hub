local isimOnbellek = {}
local function TemizIsim(isim)
    if isimOnbellek[isim] then return isimOnbellek[isim] end
    local temiz = string.gsub(isim, "%d+$", "") 
    temiz = string.gsub(temiz, "%[Lv%.?%s*%d+%]", "")
    temiz = string.gsub(temiz, "%(Lv%.?%s*%d+%)", "") 
    temiz = string.gsub(temiz, "^%s*(.-)%s*$", "%1") 
    isimOnbellek[isim] = temiz
    return temiz
end

local function SilahlariGuncelle()
    local yeniSilahBulundu = false
    local yeniSilahListesi = {}
    local mevcutMap = {}
    for _, w in ipairs(currentWeapons) do mevcutMap[w] = true end
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and not table.find(yeniSilahListesi, item.Name) then
            table.insert(yeniSilahListesi, item.Name)
            if not mevcutMap[item.Name] then yeniSilahBulundu = true end
        end
    end
    if LocalPlayer.Character then
        for _, item in pairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") and not table.find(yeniSilahListesi, item.Name) then
                table.insert(yeniSilahListesi, item.Name)
                if not mevcutMap[item.Name] then yeniSilahBulundu = true end
            end
        end
    end
    if #yeniSilahListesi == 0 then table.insert(yeniSilahListesi, "Weapon Not Found") end
    if #yeniSilahListesi ~= #currentWeapons then yeniSilahBulundu = true end
    if yeniSilahBulundu then currentWeapons = yeniSilahListesi end
    return yeniSilahBulundu
end

local function SilahlariGetir() return currentWeapons end

